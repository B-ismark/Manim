# Headers for files Cloudflare serves straight from the build (everything the
# Worker doesn't: see run_worker_first in wrangler.toml). The Worker sets the same
# ones itself for the pages it serves. server/headers.test.mjs keeps the CSP line
# identical to server/headers.mjs.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/@mediapipe/ https://js.sentry-cdn.com https://browser.sentry-cdn.com; worker-src 'self' blob:; connect-src 'self' https: wss:

# Vite fingerprints everything under /assets/ (the name changes when the content
# does), so a browser can keep them for a year and never ask again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
