node_modules
dist
dist-ssr
*.local
# tsc -b's incremental cache. Regenerated by every typecheck, so tracking it
# meant a clean checkout went dirty the first time anyone ran the compile gate.
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
*.log
.vite

# Playwright
playwright-report
test-results
# Scratch configs/scripts for a local or sandboxed run — e.g. a copy of
# playwright.config.ts that points at a preinstalled browser. One of these has
# been committed by accident before; the pattern is here so it can't happen again.
*.tmp.ts
*.tmp.mjs
*.tmp.js

# Local audit artifacts (scripts are tracked; output is not)
audit/shots
audit/scenarios
audit/responsive-audit.json
audit/loadtest-*.txt
.lighthouseci
gate-status.txt
unmerged.txt
