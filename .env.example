# ── Local dev token server (server/token.mjs) ──
# For UI-first dev you can use ANY string here; the local SFU is not required
# until you connect to real LiveKit Cloud. When you create a free LiveKit Cloud
# project, paste its API key/secret + ws URL below.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
TOKEN_SERVER_PORT=3001
# Without a real LiveKit URL the server can't verify who's host, so host status is
# unverifiable. Set ALLOW_DEV_HOST=true ONLY for local UI dev to let the first
# joiner self-declare host. Leave UNSET in production — a misconfigured prod (keys
# present but VITE_LIVEKIT_URL missing) must never let clients self-promote.
ALLOW_DEV_HOST=true

# ── Frontend (Vite exposes only VITE_* to the client) ──
# LiveKit Cloud websocket URL, e.g. wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=

# Supabase — enables accounts (email magic-link), presence + ringing.
# Leave blank to run guest-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GIF picker (optional). Free Giphy API key from developers.giphy.com.
# Leave blank to hide the GIF button.
VITE_GIPHY_KEY=

# Real email invites via Resend (optional). Without it, invites fall back to a
# mailto: link. Get a free key at resend.com.
RESEND_API_KEY=
# From address — use a verified domain, or onboarding@resend.dev for testing.
RESEND_FROM=Manim <onboarding@resend.dev>

# ── Background Web Push (optional — mobile / backgrounded / closed-tab incoming-
#    call notifications). Generate ONE keypair: `npx web-push generate-vapid-keys`.
#    Run DEPLOY.md §4c (push_subscriptions + get_push_targets) to enable. ──
#
# Public key (safe to commit / ship in the client). Set in BOTH places:
#   • VITE_VAPID_PUBLIC_KEY → Cloudflare Build vars (client subscribes with it)
#   • VAPID_PUBLIC_KEY      → Worker runtime vars (used to sign the VAPID JWT)
VITE_VAPID_PUBLIC_KEY=BFb4sU0yex6ZbG4Nonc_6V6BVA9boRRa5g37PB8YorES4X2eRYMlgS7t5JR4-jEFTo6fcRhk_XyT2_yYhGH5ZEs
VAPID_PUBLIC_KEY=BFb4sU0yex6ZbG4Nonc_6V6BVA9boRRa5g37PB8YorES4X2eRYMlgS7t5JR4-jEFTo6fcRhk_XyT2_yYhGH5ZEs
# Private key — SECRET. Do NOT commit the real value. Worker runtime var only.
# Source of truth: your password manager + the Cloudflare Worker var (retrievable
# from the Cloudflare dashboard on any machine). Generated value lives there.
VAPID_PRIVATE_KEY=
# VAPID contact (mailto: or https:) sent in the push JWT. Worker runtime var.
VAPID_SUBJECT=mailto:you@yourdomain.com

# Supabase, server-side — the Worker's push sender calls the get_push_targets RPC
# with these (it does NOT use the VITE_* build vars). Same project URL + anon key
# as the VITE_SUPABASE_* above. Worker runtime vars only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
