{
  "name": "manim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -n web,token -c cyan,magenta \"vite\" \"node server/token.mjs\"",
    "dev:web": "vite",
    "dev:token": "node server/token.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "unmerged": "git fetch -q origin main && git log --oneline origin/main..HEAD || true",
    "test:unit": "vitest run",
    "test": "playwright test --project=desktop --grep-invert @heavy",
    "test:mobile": "playwright test --project=mobile --grep-invert @heavy",
    "test:mobile-sm": "playwright test 11-mobile-fit --project=mobile-sm",
    "test:ui": "playwright test --project=desktop --ui",
    "test:a11y": "playwright test 08-a11y --project=desktop",
    "test:visual": "playwright test --project=desktop --grep @heavy --workers=1",
    "test:stress": "cross-env STRESS=1 playwright test 07-capacity --project=desktop --workers=1",
    "loadtest": "bash scripts/load-test.sh",
    "lighthouse": "lhci autorun",
    "test:sharebw": "playwright test --project=desktop --grep @heavy 90-share-bandwidth"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.25",
    "@livekit/krisp-noise-filter": "^0.3.4",
    "@livekit/track-processors": "^0.8.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@supabase/supabase-js": "^2.119.2",
    "livekit-client": "^2.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "unicode-emoji-json": "^0.9.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "livekit-server-sdk": "^2.20.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
