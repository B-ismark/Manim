{
  "name": "manim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,token -c cyan,magenta \"vite\" \"node server/token.mjs\"",
    "dev:web": "vite",
    "dev:token": "node server/token.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "playwright test --project=desktop --grep-invert @heavy",
    "test:mobile": "playwright test --project=mobile --grep-invert @heavy",
    "test:mobile-sm": "playwright test 11-mobile-fit --project=mobile-sm",
    "test:ui": "playwright test --project=desktop --ui",
    "test:a11y": "playwright test 08-a11y --project=desktop",
    "test:visual": "playwright test --project=desktop --grep @heavy --workers=1",
    "test:stress": "cross-env STRESS=1 playwright test 07-capacity --project=desktop --workers=1",
    "loadtest": "bash scripts/load-test.sh",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.9",
    "@livekit/components-styles": "^1.1.6",
    "@livekit/krisp-noise-filter": "^0.3.4",
    "@livekit/track-processors": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-visually-hidden": "^1.1.2",
    "@supabase/supabase-js": "^2.108.1",
    "livekit-client": "^2.9.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "unicode-emoji-json": "^0.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.19.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "livekit-server-sdk": "^2.10.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
